{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uranium-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "DeriveContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DERIVE",
        "class_name": "DeriveContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeriveContainer"]
    }
  ],
  // :15, after the hourly collector fires at :00 — new raw converts within
  // the hour it lands. The six-hourly reconciler's rewrites are picked up
  // the same way; the manifest makes an unchanged hour a no-op.
  "triggers": {
    "crons": ["15 * * * *"]
  },
  "vars": {
    "RAW_BUCKET": "uranium-sentiment-raw",
    "DERIVED_BUCKET": "uranium-derived-sentiment",
    // Model-phase config artifact versions the enrich pass applies; bumping
    // one forces a full re-enrich on the next run.
    "ENRICH_LEXICON": "vader-v2",
    "ENRICH_TAGS": "tags-v1",
    "DASHBOARD_SUBREDDITS": "uraniumsqueeze"
  }
  // Secrets (wrangler secret put): R2_ENDPOINT, R2_ACCESS_KEY_ID,
  // R2_SECRET_ACCESS_KEY — an R2 API token scoped to read raw, write derived.
}
